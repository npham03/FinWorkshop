PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=odoo
DB_PASSWORD=odoo_local
DB_NAME=finworkshop
JWT_SECRET=finworkshop-super-secret-jwt-key-change-in-production
DEMO_PASSWORD=FinTax@2026
TAX_API_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:5173
# Odoo remains explicitly unconfigured until you set these values.
ODOO_URL=http://127.0.0.1:8069
ODOO_DB=
ODOO_USERNAME=
ODOO_PASSWORD=
# Gmail SMTP: use a Google App Password, not your regular Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Usually leave this equal to SMTP_USER.
PASSWORD_RESET_FROM=
PASSWORD_RESET_OTP_MINUTES=10

# Automatic catalog/demo seed; false disables business demo creation.
SEED_DEMO_DATA=true
# Background durable Odoo queue worker.
ODOO_SYNC_WORKER=true
WORKSHOP_TIME_ZONE=Asia/Ho_Chi_Minh
