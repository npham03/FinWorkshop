<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fintax_sync_record_tree" model="ir.ui.view">
        <field name="name">fintax.sync.record.tree</field>
        <field name="model">fintax.sync.record</field>
        <field name="arch" type="xml">
            <tree string="Dữ liệu FinTax" create="0" edit="0" delete="0">
                <field name="entity"/>
                <field name="source_id" optional="hide"/>
                <field name="name"/>
                <field name="reference"/>
                <field name="status"/>
                <field name="counterparty" optional="hide"/>
                <field name="event_date"/>
                <field name="amount" sum="Tổng"/>
                <field name="synced_at" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_fintax_sync_record_form" model="ir.ui.view">
        <field name="name">fintax.sync.record.form</field>
        <field name="model">fintax.sync.record</field>
        <field name="arch" type="xml">
            <form string="Chi tiết dữ liệu FinTax" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Nguồn FinTax">
                            <field name="entity"/>
                            <field name="source_id"/>
                            <field name="reference"/>
                            <field name="status"/>
                        </group>
                        <group string="Thông tin nghiệp vụ">
                            <field name="counterparty"/>
                            <field name="event_date"/>
                            <field name="amount"/>
                            <field name="source_created_at"/>
                            <field name="synced_at"/>
                        </group>
                    </group>
                    <group string="Bản ghi chuẩn trong Odoo" col="4">
                        <field name="native_model"/>
                        <field name="native_id"/>
                    </group>
                    <group string="Tệp gốc" attrs="{'invisible': [('file_filename', '=', False)]}">
                        <field name="file_content" filename="file_filename" widget="binary"/>
                        <field name="file_filename" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Toàn bộ dữ liệu FinTax">
                            <field name="payload_json" nolabel="1" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fintax_sync_record_search" model="ir.ui.view">
        <field name="name">fintax.sync.record.search</field>
        <field name="model">fintax.sync.record</field>
        <field name="arch" type="xml">
            <search string="Tìm dữ liệu FinTax">
                <field name="name"/>
                <field name="reference"/>
                <field name="source_id"/>
                <field name="counterparty"/>
                <field name="entity"/>
                <field name="status"/>
                <filter name="with_status" string="Có trạng thái" domain="[('status', '!=', False)]"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_entity" string="Phân hệ" context="{'group_by': 'entity'}"/>
                    <filter name="group_status" string="Trạng thái" context="{'group_by': 'status'}"/>
                    <filter name="group_date" string="Ngày nghiệp vụ" context="{'group_by': 'event_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fintax_all" model="ir.actions.act_window">
        <field name="name">Tất cả dữ liệu FinTax</field>
        <field name="res_model">fintax.sync.record</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_fintax_sync_record_search"/>
        <field name="help" type="html"><p class="o_view_nocontent_smiling_face">Dữ liệu FinTax sẽ xuất hiện tại đây sau khi đồng bộ.</p></field>
    </record>

